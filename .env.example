# ==============================================================================
# Vikunja AI Butler — Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure your credentials.
# Ensure .env is never committed to version control (mode 0600 recommended).

# Vikunja API endpoint (e.g., https://vikunja.example.com or http://localhost:3456)
VIKUNJA_URL=https://vikunja.example.com

# Vikunja API Token (generate via Settings -> API Tokens with tasks/projects read+write permissions)
VIKUNJA_TOKEN=your_api_token_here

# (Optional) Override path to config YAML/JSON
# BUTLER_CONFIG_PATH=./config.yaml

# (Optional) Override timezone (defaults to Asia/Shanghai or system timezone)
# BUTLER_TIMEZONE=Asia/Shanghai
