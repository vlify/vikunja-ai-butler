{
  "timezone": "Asia/Shanghai",
  "vikunja": {
    "timeout_seconds": 30
  },
  "gtd": {
    "inbox_project_id": 1,
    "allowed_target_projects": {
      "5": "Single Action",
      "6": "Project",
      "7": "Waiting For"
    },
    "forbidden_target_projects": [1, 8],
    "digest_project_order": [1, 5, 6, 7]
  },
  "llm": {
    "provider": "openai-compat",
    "base_url": "http://127.0.0.1:4000/v1",
    "model": "qwen",
    "api_key_env": "LLM_GATEWAY_KEY",
    "timeout_seconds": 240
  },
  "activitywatch": {
    "enabled": false,
    "client_bin": "aw-client",
    "queries_dir": "/path/to/aw-client/queries",
    "shell_command": "",
    "background_apps": ["cs2", "steam", "screensaver"]
  },
  "notifier": {
    "type": "none",
    "account": "default",
    "from": "butler@example.com",
    "to": "user@example.com"
  },
  "backup": {
    "enabled": true,
    "file_path": ""
  },
  "morning": {
    "enabled": true,
    "matrix": {
      "homeserver_url": "",
      "room_id": "",
      "token": ""
    },
    "github": {
      "enabled": true,
      "gh_bin": "/usr/bin/gh"
    },
    "gmail": {
      "enabled": true,
      "himalaya_bin": "himalaya",
      "account": "gmail"
    },
    "target_project_id": 1
  }
}
