[Unit]
Description=Vikunja GTD Inbox Auto-Classifier
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Systemd user units support %h as the user's home directory.
# Adjust the working directory and script path to match your installation.
WorkingDirectory=%h/Projects/vikunja-ai-butler
ExecStart=%h/Projects/vikunja-ai-butler/butler/classify.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
