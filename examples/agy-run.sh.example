#!/usr/bin/env bash
# ==============================================================================
# Example LLM Caller: Antigravity CLI Wrapper
# ==============================================================================
# Usage:
#   ./agy-run.sh.example -p "Your prompt here"
#   or via stdin:
#   echo "Your prompt" | ./agy-run.sh.example
# ==============================================================================

set -euo pipefail

PROMPT=""
TIMEOUT_SEC=240

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--prompt)
            PROMPT="$2"
            shift 2
            ;;
        -t|--timeout)
            TIMEOUT_SEC="$2"
            shift 2
            ;;
        *)
            if [[ -z "$PROMPT" ]]; then
                PROMPT="$1"
                shift
            else
                shift
            fi
            ;;
    esac
done

if [[ -z "$PROMPT" && ! -t 0 ]]; then
    PROMPT="$(cat)"
fi

if [[ -z "$PROMPT" ]]; then
    echo "Error: Prompt is required." >&2
    exit 1
fi

AGY_BIN="${AGY_BIN:-agy}"

if ! command -v "$AGY_BIN" >/dev/null 2>&1; then
    echo "Error: $AGY_BIN CLI not found in PATH." >&2
    exit 127
fi

# Execute agy in print/pipe mode with timeout
exec "$AGY_BIN" --print-timeout "${TIMEOUT_SEC}s" -p "$PROMPT"
