#!/usr/bin/env bash
# ==============================================================================
# Example LLM Caller: OpenAI-compatible API Wrapper via curl
# ==============================================================================
# Usage:
#   ./openai-curl.sh.example "Your prompt here"
#   or via stdin:
#   echo "Your prompt" | ./openai-curl.sh.example
# ==============================================================================

set -euo pipefail

PROMPT="${1:-}"
if [[ -z "$PROMPT" && ! -t 0 ]]; then
    PROMPT="$(cat)"
fi

if [[ -z "$PROMPT" ]]; then
    echo "Error: Prompt is required." >&2
    exit 1
fi

OPENAI_API_KEY="${OPENAI_API_KEY:-}"
OPENAI_BASE_URL="${OPENAI_BASE_URL:-https://api.openai.com/v1}"
OPENAI_MODEL="${OPENAI_MODEL:-gpt-4o-mini}"

if [[ -z "$OPENAI_API_KEY" ]]; then
    echo "Error: OPENAI_API_KEY environment variable is not set." >&2
    exit 1
fi

PAYLOAD=$(python3 -c "
import json, sys
prompt = sys.stdin.read()
data = {
    'model': '$OPENAI_MODEL',
    'messages': [
        {'role': 'user', 'content': prompt}
    ],
    'temperature': 0.1
}
print(json.dumps(data))
" <<< "$PROMPT")

RESPONSE=$(curl -fsS -X POST "${OPENAI_BASE_URL}/chat/completions" \
    -H "Authorization: Bearer ${OPENAI_API_KEY}" \
    -H "Content-Type: application/json" \
    -d "$PAYLOAD")

python3 -c "
import json, sys
res = json.loads(sys.stdin.read())
content = res['choices'][0]['message']['content']
print(content)
" <<< "$RESPONSE"
